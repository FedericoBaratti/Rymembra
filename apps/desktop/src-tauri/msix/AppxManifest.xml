<?xml version="1.0" encoding="utf-8"?>
<!--
  Il manifesto del pacchetto MSIX per il Microsoft Store.

  Non si installa così com'è: i segnaposto {{...}} li riempie
  `strumenti/msix.js`, che prende l'identità da `identita.json` (i tre valori
  di Partner Center → Gestione prodotto → Identità del prodotto) e la versione
  da `tauri.conf.json`. Un segnaposto rimasto fa fermare lo script.

  # Perché `runFullTrust`

  Rymembra è un programma Win32 normale: legge e scrive nelle cartelle di
  musica dell'utente, apre il portachiavi, suona sul dispositivo audio. Dentro
  l'isolamento di un'app UWP non potrebbe fare niente di tutto questo.
  `runFullTrust` è la capacità «limitata» che dice al sistema di farlo girare
  come un programma Win32, e Partner Center chiede di giustificarla nell'invio.

  Non ha `internetClient`: quella capacità serve alle app isolate, e un
  programma a piena fiducia non è soggetto a quell'isolamento.

  # L'avvio con Windows: `windows.startupTask`

  L'attività dichiara che il programma può partire al login, spenta di serie
  (`Enabled="false"`): la accende l'interruttore «Avvia con Windows» delle
  Impostazioni, con l'API `StartupTask`, e l'utente la può spegnere da Gestione
  attività. Il `TaskId` è fisso e lo stesso di `rymembra-barra/src/avvio.rs`
  (`ID_ATTIVITA_STORE`): una prova in `strumenti/msix.test.js` li tiene uguali.
  Lo schema non ha un attributo per gli argomenti: il programma riconosce di
  essere partito dall'attività da `AppInstance.GetActivatedEventArgs`, non da
  una riga di comando.

  # Il protocollo `rymembra:`

  Un link di collegamento cliccato in una chat arriva al programma come un
  argomento solo, fra virgolette (`Parameters` e `%1`). I parametri sono
  ammessi solo per i programmi a piena fiducia, come questo. Il programma lo
  tratta come un input non suo: vedi `apps/desktop/src-tauri/src/argomenti.rs`.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="{{NOME}}"
    Publisher="{{EDITORE}}"
    Version="{{VERSIONE}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Rymembra</DisplayName>
    <PublisherDisplayName>{{NOME_EDITORE}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 2004 (19041). Era la 1809, mai provata: fino alla 1903 un
         pacchetto scrive in AppData con la copia alla scrittura, e i dati di
         questa copia e quelli dell'installer divergerebbero in un modo che
         nessun documento descrive. La 2004 è anche l'ultima base di Windows 10
         che WebView2 supporta. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="it-IT" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Rymembra" Executable="rymembra.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Rymembra"
        Description="{{DESCRIZIONE}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="rymembra.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="RymembraAvvio"
            Enabled="false"
            DisplayName="Rymembra" />
        </desktop:Extension>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="rymembra" Parameters="&quot;%1&quot;" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
