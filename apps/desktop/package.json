{
  "name": "rymembra-desktop",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "test:web": "node --test --import ./test/risolvi.mjs \"test/*.test.ts\"",
    "tauri": "tauri",
    "check:version": "node ../../strumenti/versione.js",
    "check:lingue": "node ../../strumenti/lingue.js",
    "check:classi": "node ../../strumenti/classi.js",
    "check:docs": "node ../../strumenti/docs.js",
    "check:sito": "node ../../strumenti/sito.js --controlla",
    "sito": "node ../../strumenti/sito.js",
    "version:set": "node ../../strumenti/versione.js",
    "licenze": "node ../../strumenti/licenze.js",
    "test:strumenti": "node --test \"../../strumenti/*.test.js\"",
    "verify": "npm run check:version && npm run check:lingue && npm run check:docs && npm run check:sito && npm run check:classi && npm run build:web && npm run test:web && npm run test:strumenti && cargo fmt --all --check --manifest-path ../../Cargo.toml && cargo clippy --workspace --all-targets --manifest-path ../../Cargo.toml && cargo test --workspace --manifest-path ../../Cargo.toml"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.9.0",
    "vite": "^7"
  }
}
